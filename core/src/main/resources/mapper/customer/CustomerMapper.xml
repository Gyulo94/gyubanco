<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gyubanco.core.modules.customer.mapper.CustomerMapper">

  <insert id="insertCustomer" parameterType="Customer" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
    INSERT INTO customer (name, email)
    VALUES (#{name}, #{email})
  </insert>

  <select id="existsByEmail" parameterType="String" resultType="boolean">
    SELECT EXISTS (
        SELECT 1
        FROM customer
        WHERE email = #{email}
    )
  </select>


  <select id="getById" parameterType="Long" resultType="Customer">
    SELECT *
    FROM customer
    WHERE id = #{id}
  </select>

</mapper>