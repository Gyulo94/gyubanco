<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gyubanco.core.modules.account.mapper.AccountMapper">

<resultMap id="accountResultMap"
          type="Account"
          >
  <id property="id" column="id"/>
  <result property="customerId" column="customer_id"/>
  <result property="accountNumber" column="account_number"/>
  <result property="accountType" column="account_type"/>
  <result property="balance" column="balance"/>
  <result property="createdAt" column="created_at"/>
  <result property="status" column="status"/>
</resultMap>

  <select id="insertAccount" parameterType="Account" resultMap="accountResultMap"  affectData="true">
    INSERT INTO account (customer_id, account_number, account_type)
    VALUES (#{customerId}, #{accountNumber}, #{accountType})
    RETURNING id, customer_id, account_number, account_type, balance, created_at, status
  </select>

  <select id="getNextAccountNumberSequence" resultType="long">
    SELECT nextval('account_number_seq')
  </select>

</mapper>